# Copy to .env (which is gitignored) and change the values.
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE="Kenyon Men's Golf CMS"
CMS_DATABASE=cms.db
# Demo accounts created by scripts/seed_demo.py
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
# Set to "on" on the team laptop, so every site update pushes site/ to gh-pages.
# Unset (as here), publishing only renders site/: safe for a fresh clone.
CMS_DEPLOY=
# GitHub token that may push to this repo (fine-grained: Contents read/write).
# Every site update sends site/ to gh-pages with it. Leave empty to use git's own login.
CMS_GITHUB_TOKEN=
# Your name for saved transcript files, first-last, lowercase (rubric H2)
CMS_STUDENT=first-last
